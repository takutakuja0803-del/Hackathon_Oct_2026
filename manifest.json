{
  "manifest_version": 3,
  "name": "Clarify",
  "version": "0.1.0",
  "description": "Turn difficult lecture language into understandable notes, visuals, and practice.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "https://your-production-domain.com/*"
    ]
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Clarify",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/notes.html",
        "src/quiz.html",
        "src/shared.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
